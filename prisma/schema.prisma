// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum AccessoryType {
  BRACELET
  NECKLACE
}

enum CatalogAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum CatalogCategoryRole {
  BEAD
  CHARM
  BASE
  CLASP
}

model Category {
  id          String              @id @default(uuid())
  name        String              @unique
  slug        String              @unique
  description String?
  order       Int                 @default(0)
  isActive    Boolean             @default(true)
  role        CatalogCategoryRole @default(BEAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes CategoryAttribute[]
  items      CatalogItem[]

  @@index([isActive, order])
}

model CategoryAttribute {
  id         String               @id @default(uuid())
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  name       String
  key        String
  type       CatalogAttributeType @default(TEXT)
  unit       String?
  isRequired Boolean              @default(false)
  options    String[]
  order      Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values CatalogItemAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, order])
}

model CatalogItem {
  id          String   @id @default(uuid())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributeValues CatalogItemAttributeValue[]
  products        ProductCatalogItem[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model CatalogItemAttributeValue {
  id          String            @id @default(uuid())
  item        CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId String
  value       String

  @@unique([itemId, attributeId])
  @@index([attributeId])
}

model Stone {
  id          String @id @default(uuid())
  name        String // "Amatista"
  description String // "Calma mental, intuición y protección espiritual."
  imageUrl    String

  // opcional pero útil a futuro
  energyTags String[] // ["calma", "protección", "intuición"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relación con productos armados
  products ProductStone[]
  images   StoneImage[]
}

model Product {
  id          String  @id @default(uuid())
  name        String // "Claridad"
  description String? // opcional si querés agregar más adelante
  price       Int // 13000 (en pesos, sin formato)
  imageUrl    String

  type AccessoryType // BRACELET o NECKLACE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ProductStone se conserva temporalmente para no perder las asociaciones históricas.
  stones       ProductStone[]
  catalogItems ProductCatalogItem[]
  images       ProductImage[]
}

model ProductCatalogItem {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId String

  @@unique([productId, itemId])
  @@index([productId])
  @@index([itemId])
}

model ProductStone {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id])
  productId String

  stone   Stone  @relation(fields: [stoneId], references: [id])
  stoneId String

  @@unique([productId, stoneId])
}

model Image {
  id    String  @id @default(cuid())
  url   String
  alt   String?
  order Int     @default(0)

  stones   StoneImage[]
  products ProductImage[]
}

model StoneImage {
  id String @id @default(uuid())

  stone   Stone  @relation(fields: [stoneId], references: [id], onDelete: Cascade)
  stoneId String

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId String

  @@unique([stoneId, imageId])
  @@index([stoneId])
  @@index([imageId])
}

model ProductImage {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId String

  @@unique([productId, imageId])
  @@index([productId])
  @@index([imageId])
}

model SharedDesign {
  id            String        @id @default(uuid())
  name          String
  shareCode     String        @unique
  type          AccessoryType
  beads         Json
  configuration Json?
  createdAt     DateTime      @default(now())
}
